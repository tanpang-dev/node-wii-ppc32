+#if defined(V8_TARGET_BIG_ENDIAN)
+  const int lo = 3, hi = 2;
+#else
+  const int lo = 2, hi = 3;
+#endif
+  InstructionOperand inputs[] = {g.UseUniqueRegister(this->input_at(node, 0)),
+                                 g.UseUniqueRegister(this->input_at(node, 1)),
+                                 g.UseUniqueRegister(this->input_at(node, lo)),
+                                 g.UseUniqueRegister(this->input_at(node, hi))};
+  Emit(kPPC_AtomicPairStore, 0, nullptr, 4, inputs);
+}
