+void MacroAssembler::SqrtDoubleSoft(DoubleRegister result, DoubleRegister src,
+                                    DoubleRegister xh, DoubleRegister tmp,
+                                    DoubleRegister cst, Register gpr) {
+  Label neg, retx, done;
+  LoadDoubleLiteral(cst, base::Double(0.0), gpr);
+  fcmpu(src, cst);
+  blt(&neg);   // x<0 -> NaN
+  beq(&retx);  // x==0(±0) -> x
+  LoadDoubleLiteral(cst, base::Double(std::numeric_limits<double>::infinity()),
+                    gpr);
+  fcmpu(src, cst);
+  beq(&retx);  // x==+inf -> x  (NaNはunordered->下へ->伝播)
+  LoadDoubleLiteral(cst, base::Double(0.5), gpr);
+  fmul(xh, src, cst);      // xh = 0.5x
+  frsqrte(result, src);    // y ~= 1/sqrt(x)
+  LoadDoubleLiteral(cst, base::Double(1.5), gpr);
+  for (int i = 0; i < 4; i++) {  // 逆数Newton-Raphson: y=y*(1.5-xh*y*y)
+    fmul(tmp, result, result);
+    fmul(tmp, tmp, xh);
+    fsub(tmp, cst, tmp);
+    fmul(result, result, tmp);
+  }
+  fmul(tmp, src, result);  // s = x*y
+  LoadDoubleLiteral(cst, base::Double(0.5), gpr);
+  fmul(result, cst, result);       // h = 0.5*y
+  fmsub(xh, tmp, tmp, src);        // xh = s*s - x
+  fneg(xh, xh);                    // xh = x - s*s = r (FMAで厳密)
+  fmadd(result, xh, result, tmp);  // result = r*h + s -> 正確丸め
+  b(&done);
+  bind(&neg);
+  LoadDoubleLiteral(
+      result, base::Double(std::numeric_limits<double>::quiet_NaN()), gpr);
+  b(&done);
+  bind(&retx);
+  fmr(result, src);
+  bind(&done);
+}
