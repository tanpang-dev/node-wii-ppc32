+  //  lowering 経由で、ppc32 では WASM を無効化済み)
+  CHECK(selector->valid(proj0) && selector->valid(proj1));
+  if (selector->valid(proj0)) {
+    outputs[output_count++] = g.DefineAsRegister(proj0);
+  } else {
+    temps[tcount++] = g.TempRegister();
+  }
+  if (selector->valid(proj1)) {
+    outputs[output_count++] = g.DefineAsRegister(proj1);
+  } else {
+    temps[tcount++] = g.TempRegister();
+  }
+  for (int k = 0; k < temp_count; k++) temps[tcount++] = g.TempRegister();
+
+  selector->Emit(opcode, output_count, outputs, input_count, inputs, tcount,
+                 temps);
+}
