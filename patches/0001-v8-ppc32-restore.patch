 void MacroAssembler::ConvertIntToDouble(Register src, DoubleRegister dst) {
+#if V8_TARGET_ARCH_PPC64
   MovIntToDouble(dst, src, r0);
   fcfid(dst, dst);
+#else
+  DCHECK(src != r0);
