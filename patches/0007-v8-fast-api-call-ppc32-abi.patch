+Node* GraphAssembler::AdaptLocalArgument(Node* argument) {
+  Node* value = AdaptLocalValue(argument);
+#ifdef V8_ABI_PASSES_HANDLES_BY_REFERENCE
+  // Local<T> は class type なので値渡しでもレジスタに載らない。callee は
+  // 「Local へのポインタ」を期待するので、Local 自体をスタックに置く。
+  // 中身は不変 (内側スロットのアドレス) なので is_tagged は false。
+  Node* handle = StackSlot(sizeof(uintptr_t), alignof(uintptr_t), false);
+  Store(StoreRepresentation(MachineType::PointerRepresentation(),
+                            kNoWriteBarrier),
+        handle, 0, value);
+  return handle;
+#else
+  return value;
 #endif
 }
 
