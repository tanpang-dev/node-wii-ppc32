 static void decodeObjectPair(ObjectPair* pair, intptr_t* x, intptr_t* y) {
+#ifdef V8_HOST_ARCH_64_BIT
   *x = static_cast<intptr_t>(pair->x);
   *y = static_cast<intptr_t>(pair->y);
+#else
+  // 32bitホストでは ObjectPair は2つのポインタを詰めた uint64_t
+  // (runtime-utils.h の MakePair 参照)。同じ並びで取り出す。
+#if defined(V8_TARGET_BIG_ENDIAN)
+  *x = static_cast<intptr_t>(*pair >> 32);
+  *y = static_cast<intptr_t>(*pair & 0xFFFFFFFFu);
+#else
+  *x = static_cast<intptr_t>(*pair & 0xFFFFFFFFu);
+  *y = static_cast<intptr_t>(*pair >> 32);
+#endif
+#endif
 }
 
