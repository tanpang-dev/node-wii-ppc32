+    inputs[input_count++] = g.UseUniqueRegister(selector->input_at(node, idx));
+  }
+
+  InstructionOperand outputs[2];
+  size_t output_count = 0;
+  InstructionOperand temps[4];
+  size_t tcount = 0;
+
+  typename Adapter::node_t proj0 = selector->FindProjection(node, 0);
+  typename Adapter::node_t proj1 = selector->FindProjection(node, 1);
+  // code-generator は出力を (下位, 上位) の固定順で書く。片方だけ生きている
+  // 場合に正しく割り当てる術がないため、その経路は未対応とする。
+  // (CSA のビルトインは常に両方使う。片方だけになるのは WASM の int64
+  //  lowering 経由で、ppc32 では WASM を無効化済み)
+  CHECK(selector->valid(proj0) && selector->valid(proj1));
+  if (selector->valid(proj0)) {
+    outputs[output_count++] = g.DefineAsRegister(proj0);
+  } else {
+    temps[tcount++] = g.TempRegister();
+  }
+  if (selector->valid(proj1)) {
+    outputs[output_count++] = g.DefineAsRegister(proj1);
+  } else {
+    temps[tcount++] = g.TempRegister();
+  }
+  for (int k = 0; k < temp_count; k++) temps[tcount++] = g.TempRegister();
+
+  selector->Emit(opcode, output_count, outputs, input_count, inputs, tcount,
+                 temps);
+}
